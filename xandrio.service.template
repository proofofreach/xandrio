[Unit]
Description=Xandrio Audiobook Player
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/audiobook-player
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Give the service its own writable /tmp. Importers extract to os.tmpdir(),
# so this must stay on — especially if you harden further with
# ProtectSystem=strict (which makes the shared /tmp read-only). With strict,
# also whitelist the app's writable dirs:
#   ProtectSystem=strict
#   ReadWritePaths=/path/to/audiobook-player/data /path/to/audiobook-player/cache
PrivateTmp=true

# Environment — load from .env file (no secrets in the unit file)
Environment=NODE_ENV=production
EnvironmentFile=/path/to/audiobook-player/.env

[Install]
WantedBy=multi-user.target
