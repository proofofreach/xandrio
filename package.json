{
  "name": "xandrio",
  "version": "1.1.0",
  "description": "Self-hosted personal reading server with EPUB, PDF, Kindle, and text-to-speech playback",
  "main": "server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProofOfReach/alexandrio.git"
  },
  "bugs": {
    "url": "https://github.com/ProofOfReach/alexandrio/issues"
  },
  "homepage": "https://github.com/ProofOfReach/alexandrio#readme",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "prestart": "node --env-file-if-exists=.env scripts/ensure-tailscale-serve.js",
    "start": "node --env-file-if-exists=.env server.js",
    "predev": "node --env-file-if-exists=.env scripts/ensure-tailscale-serve.js",
    "dev": "node --env-file-if-exists=.env node_modules/nodemon/bin/nodemon.js server.js",
    "local-service:install": "node scripts/manage-local-service.js install",
    "local-service:restart": "node scripts/manage-local-service.js restart",
    "local-service:status": "node scripts/manage-local-service.js status",
    "benchmark:pipeline": "node scripts/benchmark-pipeline.js",
    "benchmark:kokoro": "node scripts/benchmark-kokoro-quality.js",
    "benchmark:kokoro-split": "node scripts/benchmark-kokoro-split-ab.js",
    "benchmark:kokoro-split-sweep": "node scripts/benchmark-kokoro-split-sweep.js",
    "benchmark:pdf": "node scripts/benchmark-pdf-extraction.js",
    "benchmark:kindle": "node scripts/benchmark-kindle-extraction.js",
    "benchmark:imports": "node scripts/benchmark-import-reliability.js",
    "benchmark:imports:bakeoff": "node scripts/benchmark-import-bakeoff.js",
    "benchmark:book-guides": "node scripts/benchmark-book-guides.js",
    "benchmark:tts": "node scripts/benchmark-tts.js",
    "benchmark:first-play": "node scripts/benchmark-mobile-playback-continuity.js",
    "benchmark:mobile-playback": "node scripts/benchmark-mobile-playback-continuity.js",
    "build:calibre-plugin": "node scripts/build-calibre-plugin.mjs",
    "verify:audio": "node scripts/verify-audio-quality.js",
    "verify:audio:ci": "node scripts/verify-audio-quality.js --calibration-fixtures",
    "audit:production": "npm audit --omit=dev",
    "audit:release": "npm audit --omit=dev --audit-level=high",
    "audit:imports": "node scripts/audit-private-import-corpus.js",
    "sbom:npm": "npx @cyclonedx/cyclonedx-npm --omit dev --output-format JSON --output-file artifacts/xandrio-npm.cdx.json",
    "sbom:python": "node scripts/release/generate-python-sboms.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "check:docker-context": "node scripts/release/check-docker-context.mjs",
    "check:release-assets": "node scripts/release/check-release-assets.mjs",
    "check:release-approvals": "node scripts/release/check-release-approvals.mjs",
    "check:release-contacts": "node scripts/release/check-release-contacts.mjs",
    "check:public-repository": "node scripts/release/check-public-repository.mjs",
    "sync:public": "node scripts/release/sync-public.mjs",
    "release:production": "node --env-file-if-exists=.env scripts/release/release-production.mjs",
    "deploy:production": "node --env-file-if-exists=.env scripts/release/deploy-production.mjs",
    "scan:history": "node scripts/release/scan-git-history.mjs",
    "release:prepare-public-root": "node scripts/release/prepare-public-root.mjs",
    "release:verify": "node scripts/release/verify-release-consistency.mjs",
    "backfill:metadata": "node scripts/backfill-book-metadata.js",
    "recover:json": "node scripts/recover-json-store.js",
    "test": "node test/run-all.js",
    "test:browser": "node scripts/smoke-browser.js",
    "test:desktop-workspace": "node test/test-desktop-workspace-geometry.js",
    "test:ui-findings": "node test/test-ui-findings-regression.js",
    "scenario:serve": "node scripts/scenario-server.js",
    "scenario:shots": "node scripts/scenario-shots.js",
    "scenario:verify-viewport": "node test/fixtures/scenarios/verify-viewport-rendering.js",
    "scenario:verify-fixtures": "node test/fixtures/scenarios/verify-fixture-integrity.js",
    "scenario:verify-settings": "node test/fixtures/scenarios/verify-settings-state-addressability.js",
    "scenario:verify-stats": "node test/fixtures/scenarios/verify-stats-state-addressability.js",
    "scenario:verify-player-sheets": "node test/fixtures/scenarios/verify-player-sheet-addressability.js",
    "scenario:verify-exit": "node test/fixtures/scenarios/verify-scenario-gate-exit.js",
    "scenario:verify-isolation": "node test/fixtures/scenarios/verify-network-guard.js",
    "scenario:verify": "node scripts/run-ws00-scenario-gate.mjs .",
    "verify:android-lockscreen": "node scripts/verify-android-lockscreen.js",
    "gauntlet:validate": "loopc validate ops/gauntlet/xandrio.loop.yaml",
    "gauntlet:verify": "loopc verify ops/gauntlet/xandrio.loop.yaml --fixtures ops/gauntlet/verify-fixtures.json",
    "gauntlet:score": "loopc score ops/gauntlet/xandrio.loop.yaml --fixtures ops/gauntlet/verify-fixtures.json",
    "gauntlet:compile": "loopc compile ops/gauntlet/xandrio.loop.yaml --target standalone --out output/xandrio-gauntlet",
    "gauntlet:judge": "node scripts/run-xandrio-gauntlet-judge.mjs . artifacts/gauntlet/progress.md"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "^0.4.6",
    "body-parser": "2.3.0",
    "cors": "^2.8.5",
    "epub": "2.1.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "https-proxy-agent": "^9.1.0",
    "multer": "2.2.0",
    "node-edge-tts": "1.2.10",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "6.2.108",
    "playwright": "1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-extra-plugin-user-data-dir": "2.3.3",
    "puppeteer-extra-plugin-user-preferences": "2.3.3",
    "undici": "8.10.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@loopyc/cli": "0.8.0",
    "axios": "1.19.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "ws": "8.21.0",
    "qs": "6.15.3",
    "brace-expansion": "1.1.18",
    "minimatch": "3.1.4",
    "puppeteer-extra-plugin-user-data-dir": "2.3.3",
    "puppeteer-extra-plugin-user-preferences": "2.3.3",
    "tar": "7.5.22"
  }
}
